# Telegram
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_PROXY_URL=

# Ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TEMPERATURE=0.8
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=8192

# Персона и few-shot: сколько примеров из EXAMPLES_FILE подмешивать в промпт (0 после fine-tune)
PERSONA_FILE=data/persona.txt
EXAMPLES_FILE=data/examples.jsonl
FEW_SHOT_EXAMPLES=25
HISTORY_LIMIT=20

# Security
# Твой Telegram ID — только этот аккаунт может подключить бота через Telegram Business
OWNER_TELEGRAM_ID=
BOT_ACCESS_PASSWORD=change_me
ALLOWED_TELEGRAM_USER_IDS=

# Telegram Business
# ID собеседников через запятую, которым бот не отвечает
BUSINESS_IGNORE_CHAT_IDS=
OWNER_TAKEOVER_MINUTES=30
REPLY_DEBOUNCE_SECONDS=8
SPLIT_REPLY_LINES=true
MAX_REPLY_MESSAGES=3
TYPING_SECONDS_PER_CHAR=0.05
TYPING_MAX_SECONDS=6

# Request settings
REQUEST_TIMEOUT=180
